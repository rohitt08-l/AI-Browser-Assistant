# Primary provider: groq | azure | openai
LLM_PROVIDER=groq
# Optional: used automatically if the primary provider fails
# LLM_FALLBACK_PROVIDER=azure

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_NAME=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings for Q&A on very long pages: none (BM25, no API calls) | azure | openai
EMBEDDINGS_PROVIDER=none
# AZURE_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small

# Pages up to this many tokens are sent in full. Groq's free tier allows ~12k tokens/min,
# so keep this low there; raise it (e.g. 60000) on Azure / paid plans.
MAX_CONTEXT_TOKENS=10000

# Lock CORS to your published extension in production:
# CORS_ALLOW_ORIGIN_REGEX=^chrome-extension://<your-extension-id>$
